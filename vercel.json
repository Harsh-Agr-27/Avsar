{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "avsar": {
      "root": "Avsar",
      "framework": "django",
      "functions": {
        "Avsar/wsgi.py": {
          "maxDuration": 60
        }
      }
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "avsar"
      }
    }
  ]
}
