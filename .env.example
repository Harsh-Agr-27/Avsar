# Copy to .env for local development, or set these in the Vercel dashboard.
# Django reads the environment first and only falls back to these files locally.

# --- Django -----------------------------------------------------------------
# Required on Vercel (at request time; the build runs without it). Generate one
# with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DEBUG=False

# Comma-separated hosts. Vercel deployment hostnames (*.vercel.app) are added
# automatically; list custom domains here.
ALLOWED_HOSTS=localhost,127.0.0.1
# Comma-separated HTTPS origins allowed to POST, e.g. https://avsar.example.com
CSRF_TRUSTED_ORIGINS=

# --- Database ---------------------------------------------------------------
# A single URL is all Vercel Postgres / Neon / Supabase needs. It must include
# ?sslmode=require for providers that enforce TLS.
DATABASE_URL=

# Discrete settings, used when DATABASE_URL is empty and DB_HOST is set.
# DB_NAME=Avsar
# DB_USER=postgres
# DB_PASSWORD=
# DB_HOST=localhost
# DB_PORT=5432
# DB_CONN_MAX_AGE=0

# Without any database configuration the app falls back to SQLite. On Vercel
# that file lives in /tmp and is discarded, so it is demo-only.
# SQLITE_PATH=/absolute/path/to/db.sqlite3

# --- Startup behaviour ------------------------------------------------------
# Vercel Functions have no release phase, so migrations run on cold start.
# Set to false once you migrate from CI or your machine instead.
AUTO_MIGRATE=true
# AUTO_MIGRATE_VERBOSITY=0

# --- Optional ---------------------------------------------------------------
# LOG_LEVEL=INFO
# SECURE_HSTS_SECONDS=31536000
